From 8daba5864119b79e0ee0d4e3e4fef542439a6704 Mon Sep 17 00:00:00 2001
From: Vibe <vibe@localhost>
Date: Tue, 24 Nov 2026 09:41:13 +0000
Subject: [PATCH] Port foliar optical factors to phsdata
 (UnderstoryMultiplicativeFactor{,List} in UnderstoryModel); write v<i>OF
 texture via OpticalFactorsTextureWriter::writeTexture like the surface
 writers; fix equivalent-lambertian OF to reuse the foliar texture (was
 wrongly reading lambertian OF with foliar index); delete
 PhaseDAO::readCoeffDiffParametersForFoliarOpticalFactors; CONTEXT.md item 20

---
 CONTEXT.md                                    | 20 ++++-
 Phase/include/PhaseDAO.hpp                    |  2 -
 .../vegetation/UnderstoryModel.hpp            |  7 ++
 .../UnderstoryMultiplicativeFactor.hpp        | 49 +++++++++++++
 Phase/src/PhaseDAO.cpp                        |  6 --
 .../materials/VegetationMaterialWriter.cpp    | 72 ++++++-------------
 6 files changed, 95 insertions(+), 61 deletions(-)
 create mode 100644 Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryMultiplicativeFactor.hpp

diff --git a/CONTEXT.md b/CONTEXT.md
index f783c4e..e9a00ec 100644
--- a/CONTEXT.md
+++ b/CONTEXT.md
@@ -213,6 +213,19 @@ Sandbox notes for rebuilding the prefix (no root available):
     into the per-model FoliarModel params (no PhaseDAO read); the DAO functions
     readCoeffDiffParametersForFoliar{,XML} are deleted. v5->v6 renames handled
     by the external XML upgrader, not here.
+20. Foliar optical factors ported to phsdata + written by Phase itself (this
+    session): new phsdata::UnderstoryMultiplicativeFactor{,List} (mirrors the
+    lambertian ones, with leafTransmittanceFactor), loaded in
+    UnderstoryModel as nodeMultiplicativeFactor from
+    UnderstoryNodeMultiplicativeFactorForLUT. VegetationMaterialWriter::treat()
+    now writes the v<foliarIndice>OF texture via
+    OpticalFactorsTextureWriter::writeTexture() (like the surface writers;
+    previously written by another module) and the equivalent-lambertian
+    materials reference the SAME foliar texture -- fixing the bug where the
+    old code read the LAMBERTIAN optical factors with the foliar model index.
+    PhaseDAO::readCoeffDiffParametersForFoliarOpticalFactors deleted.
+    NOTE: duplicateFirstMatrixLayer in the v6 template is a producer-side
+    error (to be dropped from the XML); phsdata deliberately does NOT read it.
 
 ## Known TODOs / open points (next sessions)
 
@@ -238,10 +251,11 @@ Sandbox notes for rebuilding the prefix (no root available):
   direction-set-dependent precomputing only on change; output model index is
   UnderstoryMulti::indexFunction.
 - Port the remaining foliar PhaseDAO reads into phsdata::UnderstoryMulti:
-  readCoeffDiffParametersForFoliar (LAD params) DONE (history item 19);
+  readCoeffDiffParametersForFoliar (LAD params) DONE (item 19);
+  readCoeffDiffParametersForFoliarOpticalFactors DONE (item 20);
   still to do: readMultiplicativeFactorFoliar
-  (UnderstoryNodeMultiplicativeFactorForLUT),
-  readCoeffDiffParametersForFoliarOpticalFactors.
+  (UnderstoryNodeMultiplicativeFactorForLUT -- same subtree as the optical
+  factors, can reuse phsdata::UnderstoryMultiplicativeFactorList).
 - Remove the redundant per-band LAD recompute inside
   PhasePolarization::computeAndWriteFoliarPolarizationMatrix{,NotBinary}:
   DONE (history item 18).
diff --git a/Phase/include/PhaseDAO.hpp b/Phase/include/PhaseDAO.hpp
index fb15c52..bfd338c 100644
--- a/Phase/include/PhaseDAO.hpp
+++ b/Phase/include/PhaseDAO.hpp
@@ -135,8 +135,6 @@ public:
 
    static bool readCoeffDiffParametersForLambertianOpticalFactors(const int & index,
                                OpticalFactorParameters & opticalFactorParameters);
-	static bool readCoeffDiffParametersForFoliarOpticalFactors(const int & index,
-								OpticalFactorParameters & opticalFactorParameters);
    static bool readCoeffDiffParametersForFluidOpticalFactors(const int & index,
                                OpticalFactorParameters & opticalFactorParameters);
    static bool readCoeffDiffParametersOpticalFactorsXML(	const string & key,
diff --git a/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryModel.hpp b/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryModel.hpp
index d0bb996..ef4c529 100644
--- a/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryModel.hpp
+++ b/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryModel.hpp
@@ -12,6 +12,7 @@
 
 #include \"DartSAParameters.h\"
 #include \"../ProspectExternalModule.hpp\"
+#include \"UnderstoryMultiplicativeFactor.hpp\"
 
 namespace phsdata {
 class UnderstoryModel {
@@ -19,12 +20,18 @@ public:
 	std::string modelName;
 	std::string databaseName;  // Overwritten by prepareProspect() when a prospect database is generated
 	ProspectExternalModule prospectExternalModule;
+\tboost::optional<UnderstoryMultiplicativeFactorList> nodeMultiplicativeFactor;  // Child node
 
 	void loadFromParameters(const std::string& prefix) {
 		modelName = DartSAParameters::get<std::string>(prefix + \".modelName\");
 		databaseName = DartSAParameters::get<std::string>(prefix + \".databaseName\");
 
 		prospectExternalModule.loadFromParameters(prefix + \".ProspectExternalModule\");
+
+\t\tif (DartSAParameters::exists(prefix + \".UnderstoryNodeMultiplicativeFactorForLUT\")) {
+\t\t\tnodeMultiplicativeFactor = UnderstoryMultiplicativeFactorList();
+\t\t\tnodeMultiplicativeFactor->loadFromParameters(prefix + \".UnderstoryNodeMultiplicativeFactorForLUT\");
+\t\t}
