+++ b/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryMultiplicativeFactor.hpp
@@ -0,0 +1,49 @@
+/*
+ * UnderstoryMultiplicativeFactor.hpp
+ *
+ *  Multiplicative factors of one foliar (vegetation) model face: same layout
+ *  as the lambertian ones, but with leafTransmittanceFactor instead of
+ *  direct/diffuseTransmittanceFactor (see XMLTemplate v6, UnderstoryMultiModel
+ *  subtree).
+ */
+
+#ifndef INCLUDE_INPUTS_STORAGE_OPTICALMATERIALS_VEGETATION_UNDERSTORYMULTIPLICATIVEFACTOR_HPP_
+#define INCLUDE_INPUTS_STORAGE_OPTICALMATERIALS_VEGETATION_UNDERSTORYMULTIPLICATIVEFACTOR_HPP_
+
+#include <string>
+#include <vector>
+#include <memory>
+#include <boost/optional.hpp>
+
+#include \"../MultiplicativeFactor.hpp\"
+
+namespace phsdata {
+class UnderstoryMultiplicativeFactor: public MultiplicativeFactor {
+public:
+\tdouble reflectanceFactor = 1.;
+\tdouble leafTransmittanceFactor = 1.;
+
+\tvoid loadFromParameters(const std::string& prefix) override {
+\t\tMultiplicativeFactor::loadFromParameters(prefix);  // Load shared fields
+\t\treflectanceFactor = DartSAParameters::get<double>(prefix + \".reflectanceFactor\");
+\t\tleafTransmittanceFactor = DartSAParameters::get<double>(prefix + \".leafTransmittanceFactor\");
+\t}
+};
+
+class UnderstoryMultiplicativeFactorList: public MultiplicativeFactorList {
+public:
+\tvoid loadFromParameters(const std::string& prefix) override {
+\t\tMultiplicativeFactorList::loadFromParameters(prefix);  // Load shared fields
+
+\t\t// Load repeated nodes (UnderstoryMultiplicativeFactorForLUT[0], [1], ...)
+\t\tint count = DartSAParameters::getNbOf(prefix + \".UnderstoryMultiplicativeFactorForLUT\");
+\t\tfor (int i = 0; i < count; ++i) {
+\t\t\tauto factor = std::make_shared<UnderstoryMultiplicativeFactor>();
+\t\t\tfactor->loadFromParameters(prefix + \".UnderstoryMultiplicativeFactorForLUT[\" + std::to_string(i) + \"]\");
+\t\t\tfactors.push_back(factor);
+\t\t}
+\t}
+};
+}
+
+#endif /* INCLUDE_INPUTS_STORAGE_OPTICALMATERIALS_VEGETATION_UNDERSTORYMULTIPLICATIVEFACTOR_HPP_ */
