diff --git a/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryMultiplicativeFactor.hpp b/Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryMultiplicativeFactor.hpp
